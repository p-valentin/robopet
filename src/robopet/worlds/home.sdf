<?xml version="1.0"?>
<!-- Robopet's home: a walled room with a food bowl, a bed and a toy ball. Coordinates in metres.
     Keep these in sync with PLACES in robopet/motion.py. -->
<sdf version="1.8">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.75 0.85 0.95 1</background><shadows>false</shadows></scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor"><static>true</static>
      <link name="l">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.85 0.8 0.65 1</ambient><diffuse>0.85 0.8 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- walls: room is x -3.5..3.5, y -3..3 -->
    <model name="walls"><static>true</static>
      <link name="l">
        <collision name="n"><pose>0 3.05 0.15 0 0 0</pose><geometry><box><size>7.1 0.1 0.3</size></box></geometry></collision>
        <visual name="n"><pose>0 3.05 0.15 0 0 0</pose><geometry><box><size>7.1 0.1 0.3</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
        <collision name="s"><pose>0 -3.05 0.15 0 0 0</pose><geometry><box><size>7.1 0.1 0.3</size></box></geometry></collision>
        <visual name="s"><pose>0 -3.05 0.15 0 0 0</pose><geometry><box><size>7.1 0.1 0.3</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
        <collision name="e"><pose>3.55 0 0.15 0 0 0</pose><geometry><box><size>0.1 6.1 0.3</size></box></geometry></collision>
        <visual name="e"><pose>3.55 0 0.15 0 0 0</pose><geometry><box><size>0.1 6.1 0.3</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
        <collision name="w"><pose>-3.55 0 0.15 0 0 0</pose><geometry><box><size>0.1 6.1 0.3</size></box></geometry></collision>
        <visual name="w"><pose>-3.55 0 0.15 0 0 0</pose><geometry><box><size>0.1 6.1 0.3</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- food bowl (red, with food) at (2.4, 1.6) -->
    <model name="bowl"><static>true</static><pose>2.4 1.6 0 0 0 0</pose>
      <link name="l">
        <visual name="dish"><pose>0 0 0.04 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
        <visual name="food"><pose>0 0 0.085 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.1 1</ambient><diffuse>0.55 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- bed (blue, with a white pillow) at (-2.4, 1.6) -->
    <model name="bed"><static>true</static><pose>-2.4 1.6 0 0 0 0</pose>
      <link name="l">
        <visual name="mattress"><pose>0 0 0.07 0 0 0</pose><geometry><box><size>1.0 0.7 0.14</size></box></geometry>
          <material><ambient>0.2 0.35 0.85 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>
        <visual name="pillow"><pose>-0.35 0 0.17 0 0 0</pose><geometry><box><size>0.25 0.5 0.07</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <!-- toy ball (yellow) at (1.8, -2.0) -->
    <model name="ball"><static>true</static><pose>1.8 -2.0 0 0 0 0</pose>
      <link name="l">
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
